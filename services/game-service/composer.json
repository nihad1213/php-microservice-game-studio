{
    "name": "studio/developer-service",
    "require": {
        "php": ">=8.3",
        "studio/core": "@dev",
        "slim/slim": "^4.14",
        "slim/psr7": "^1.8",
        "php-di/php-di": "^7.1",
        "php-di/slim-bridge": "^3.4",
        "monolog/monolog": "^3.12",
        "respect/validation": "^2.3",
        "robmorgan/phinx": "^0.16.12",
        "guzzlehttp/guzzle": "^7.16",
        "firebase/php-jwt": "^7.2",
        "predis/predis": "^2.4",
        "ramsey/uuid": "^4.10"
    },
    "repositories": [{
        "name": "core",
        "type": "path",
        "url": "../../shared"
    }],
    "autoload": {
        "psr-4": { "App\\": "src/" }
    },

    "autoload-dev": {
        "psr-4": { "Tests\\": "tests/" }
    },
    
    "config": {
        "sort-packages": true 
    }
}
